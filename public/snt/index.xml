      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/mabemat/snt/seance-03-conditionnelles-qcm/</guid>
      <description>&lt;div class=&#34;qcm-q&#34; data-correct=&#34;1&#34;&gt;&#xA;  &lt;div class=&#34;qcm-question&#34;&gt;&#xA;    Quel mot-clé permet d&amp;rsquo;&lt;strong&gt;exécuter du code sous condition&lt;/strong&gt; en Python ?&#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-opts&#34;&gt;&#xA;    &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;0&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;condition&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;1&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;if&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;2&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;where&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;3&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;case&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-exp&#34; style=&#34;display:none;margin-top:0.8rem;&#34;&gt;&lt;/div&gt;&#xA;  &#xA;  &lt;div class=&#34;qcm-correction&#34; style=&#34;display:none;margin-top:0.5rem;margin-left:2rem;padding:0.8rem 1rem;background:none;border-left:3px solid none;border-radius:0 4px 4px 0;&#34;&gt;&#xA;    &lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Mot-clé&lt;/th&gt;&#xA;          &lt;th&gt;Rôle en Python&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;if&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;&lt;strong&gt;Si&lt;/strong&gt; la condition est vraie, exécuter le bloc&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;elif&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;&lt;strong&gt;Sinon si&lt;/strong&gt; une autre condition est vraie&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;else&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;&lt;strong&gt;Sinon&lt;/strong&gt;, exécuter le bloc final&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;p&gt;&lt;code&gt;condition&lt;/code&gt;, &lt;code&gt;where&lt;/code&gt;, &lt;code&gt;case&lt;/code&gt; n&amp;rsquo;existent pas dans la syntaxe Python.&lt;/p&gt;&#xA;&lt;p&gt;&lt;strong&gt;Réponse : &lt;code&gt;if&lt;/code&gt;&lt;/strong&gt;&lt;/p&gt;&#xA;&#xA;  &lt;/div&gt;&#xA;  &#xA;&lt;/div&gt;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;  &#xA;  &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;&#xA;&#xA;&lt;div class=&#34;qcm-q&#34; data-correct=&#34;2&#34;&gt;&#xA;  &lt;div class=&#34;qcm-question&#34;&gt;&#xA;    &lt;p&gt;Par quel caractère doit se terminer la ligne &lt;code&gt;if&lt;/code&gt; ?&lt;/p&gt;</description>
    </item>
    <item>
      <title>QCM - Fonctions</title>
      <link>http://localhost:1313/mabemat/snt/seance-02-fonctions-qcm/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/mabemat/snt/seance-02-fonctions-qcm/</guid>
      <description>&lt;div class=&#34;qcm-q&#34; data-correct=&#34;1&#34;&gt;&#xA;  &lt;div class=&#34;qcm-question&#34;&gt;&#xA;    Quel mot-clé permet de &lt;strong&gt;définir&lt;/strong&gt; une fonction en Python ?&#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-opts&#34;&gt;&#xA;    &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;0&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;function&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;1&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;def&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;2&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;define&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;3&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;func&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-exp&#34; style=&#34;display:none;margin-top:0.8rem;&#34;&gt;&lt;/div&gt;&#xA;  &#xA;  &lt;div class=&#34;qcm-correction&#34; style=&#34;display:none;margin-top:0.5rem;margin-left:2rem;padding:0.8rem 1rem;background:none;border-left:3px solid none;border-radius:0 4px 4px 0;&#34;&gt;&#xA;    &lt;p&gt;En Python, une fonction commence toujours par &lt;code&gt;def&lt;/code&gt;, suivi du nom puis des parenthèses.&lt;/p&gt;&#xA;&lt;p&gt;&lt;strong&gt;Réponse : &lt;code&gt;def&lt;/code&gt;&lt;/strong&gt;&lt;/p&gt;&#xA;&#xA;  &lt;/div&gt;&#xA;  &#xA;&lt;/div&gt;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;  &#xA;  &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;&#xA;&#xA;&lt;div class=&#34;qcm-q&#34; data-correct=&#34;2&#34;&gt;&#xA;  &lt;div class=&#34;qcm-question&#34;&gt;&#xA;    &lt;p&gt;Par quel caractère doit se terminer la &lt;strong&gt;première ligne&lt;/strong&gt; d&amp;rsquo;une définition de fonction ?&lt;/p&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;background-color:#f0f0f0;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-python&#34; data-lang=&#34;python&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span style=&#34;white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f&#34;&gt;1&lt;/span&gt;&lt;span&gt;&lt;span style=&#34;color:#007020;font-weight:bold&#34;&gt;def&lt;/span&gt; &lt;span style=&#34;color:#06287e&#34;&gt;aire&lt;/span&gt;(c)&lt;span style=&#34;&#34;&gt;?&lt;/span&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span style=&#34;white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f&#34;&gt;2&lt;/span&gt;&lt;span&gt;    &lt;span style=&#34;color:#007020;font-weight:bold&#34;&gt;return&lt;/span&gt; c &lt;span style=&#34;color:#666&#34;&gt;*&lt;/span&gt; c&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-opts&#34;&gt;&#xA;    &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;0&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;;&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;1&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;.&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;2&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;:&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;3&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;,&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-exp&#34; style=&#34;display:none;margin-top:0.8rem;&#34;&gt;&lt;/div&gt;&#xA;  &#xA;  &lt;div class=&#34;qcm-correction&#34; style=&#34;display:none;margin-top:0.5rem;margin-left:2rem;padding:0.8rem 1rem;background:none;border-left:3px solid none;border-radius:0 4px 4px 0;&#34;&gt;&#xA;    &lt;p&gt;Sans les deux-points, Python signale une &lt;code&gt;SyntaxError&lt;/code&gt;.&lt;/p&gt;</description>
    </item>
    <item>
      <title>QCM - Variables et affectation</title>
      <link>http://localhost:1313/mabemat/snt/seance-01-variables-qcm/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/mabemat/snt/seance-01-variables-qcm/</guid>
      <description>&lt;div class=&#34;qcm-q&#34; data-correct=&#34;1&#34;&gt;&#xA;  &lt;div class=&#34;qcm-question&#34;&gt;&#xA;    &lt;p&gt;Qu&amp;rsquo;affiche ce programme ?&lt;/p&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;background-color:#f0f0f0;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-python&#34; data-lang=&#34;python&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span style=&#34;white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f&#34;&gt;1&lt;/span&gt;&lt;span&gt;message &lt;span style=&#34;color:#666&#34;&gt;=&lt;/span&gt; &lt;span style=&#34;color:#4070a0&#34;&gt;&amp;#34;Bonjour&amp;#34;&lt;/span&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span style=&#34;white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f&#34;&gt;2&lt;/span&gt;&lt;span&gt;&lt;span style=&#34;color:#007020&#34;&gt;print&lt;/span&gt;(message)&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-opts&#34;&gt;&#xA;    &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;0&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;message&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;1&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;Bonjour&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;2&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;&amp;quot;Bonjour&amp;quot;&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;3&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;Rien&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-exp&#34; style=&#34;display:none;margin-top:0.8rem;&#34;&gt;&lt;/div&gt;&#xA;  &#xA;  &lt;div class=&#34;qcm-correction&#34; style=&#34;display:none;margin-top:0.5rem;margin-left:2rem;padding:0.8rem 1rem;background:none;border-left:3px solid none;border-radius:0 4px 4px 0;&#34;&gt;&#xA;    &lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th style=&#34;text-align: center&#34;&gt;Ligne&lt;/th&gt;&#xA;          &lt;th&gt;&lt;code&gt;message&lt;/code&gt;&lt;/th&gt;&#xA;          &lt;th&gt;Affichage&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;1&lt;/td&gt;&#xA;          &lt;td&gt;&lt;code&gt;&amp;quot;Bonjour&amp;quot;&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;-&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;2&lt;/td&gt;&#xA;          &lt;td&gt;&lt;code&gt;&amp;quot;Bonjour&amp;quot;&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;&lt;strong&gt;&lt;code&gt;Bonjour&lt;/code&gt;&lt;/strong&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;p&gt;&lt;code&gt;print()&lt;/code&gt; affiche la &lt;strong&gt;valeur&lt;/strong&gt; de la variable, sans les guillemets. &lt;br&gt;&#xA;Écrire &lt;code&gt;print(message)&lt;/code&gt; n&amp;rsquo;affiche pas le mot &lt;code&gt;message&lt;/code&gt;, mais ce que contient la variable.&lt;/p&gt;&#xA;&lt;p&gt;&lt;strong&gt;Réponse : &lt;code&gt;Bonjour&lt;/code&gt;&lt;/strong&gt;&lt;/p&gt;&#xA;&#xA;  &lt;/div&gt;&#xA;  &#xA;&lt;/div&gt;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;  &#xA;  &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;&#xA;&#xA;&lt;div class=&#34;qcm-q&#34; data-correct=&#34;0&#34;&gt;&#xA;  &lt;div class=&#34;qcm-question&#34;&gt;&#xA;    Quel est le type de la variable &lt;code&gt;n&lt;/code&gt; après &lt;code&gt;n = 42&lt;/code&gt; ?&#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-opts&#34;&gt;&#xA;    &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;0&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;int&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;1&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;float&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;2&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;str&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;3&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;bool&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-exp&#34; style=&#34;display:none;margin-top:0.8rem;&#34;&gt;&lt;/div&gt;&#xA;  &#xA;  &lt;div class=&#34;qcm-correction&#34; style=&#34;display:none;margin-top:0.5rem;margin-left:2rem;padding:0.8rem 1rem;background:none;border-left:3px solid none;border-radius:0 4px 4px 0;&#34;&gt;&#xA;    &lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Valeur&lt;/th&gt;&#xA;          &lt;th&gt;Type&lt;/th&gt;&#xA;          &lt;th&gt;Explication&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;42&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;&lt;code&gt;int&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Nombre entier, sans virgule&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;42.0&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;&lt;code&gt;float&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Nombre décimal (point décimal présent)&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;&amp;quot;42&amp;quot;&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;&lt;code&gt;str&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Texte (entre guillemets)&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;p&gt;Un nombre entier sans guillemets et sans point décimal est toujours de type &lt;code&gt;int&lt;/code&gt;.&lt;/p&gt;</description>
    </item>
