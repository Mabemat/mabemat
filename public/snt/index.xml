    <item>
      <title>QCM - Bilan : Fonctions et Boucles</title>
      <link>http://localhost:1313/mabemat/snt/seance-06-bilan-qcm/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/mabemat/snt/seance-06-bilan-qcm/</guid>
      <description>&lt;div class=&#34;qcm-q&#34; data-correct=&#34;1&#34;&gt;&#xA;  &lt;div class=&#34;qcm-question&#34;&gt;&#xA;    Quel mot-clé permet de &lt;strong&gt;définir&lt;/strong&gt; une fonction en Python ?&#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-opts&#34;&gt;&#xA;    &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;0&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;function&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;1&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;def&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;2&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;define&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;3&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;func&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-exp&#34; style=&#34;display:none;margin-top:0.8rem;&#34;&gt;&lt;/div&gt;&#xA;  &#xA;  &lt;div class=&#34;qcm-correction&#34; style=&#34;display:none;margin-top:0.5rem;margin-left:2rem;padding:0.8rem 1rem;background:none;border-left:3px solid none;border-radius:0 4px 4px 0;&#34;&gt;&#xA;    &lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Mot-clé&lt;/th&gt;&#xA;          &lt;th&gt;Rôle&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;def&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;&lt;strong&gt;Définit&lt;/strong&gt; une fonction (&lt;code&gt;def f(x):&lt;/code&gt;)&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;if&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Teste une condition&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;for&lt;/code&gt; / &lt;code&gt;while&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Répète un bloc&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;return&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Renvoie une valeur depuis une fonction&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;p&gt;&lt;strong&gt;Réponse : &lt;code&gt;def&lt;/code&gt;&lt;/strong&gt;&lt;/p&gt;&#xA;  &lt;/div&gt;&#xA;  &#xA;&lt;/div&gt;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;  &#xA;  &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;&#xA;&#xA;&lt;div class=&#34;qcm-q&#34; data-correct=&#34;1&#34;&gt;&#xA;  &lt;div class=&#34;qcm-question&#34;&gt;&#xA;    À quoi sert l&amp;rsquo;instruction &lt;code&gt;return&lt;/code&gt; dans une fonction ?&#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-opts&#34;&gt;&#xA;    &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;0&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;À afficher une valeur à l&amp;rsquo;écran&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;1&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;À &lt;strong&gt;renvoyer une valeur&lt;/strong&gt; au programme qui a appelé la fonction&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;2&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;À arrêter complètement le programme&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;3&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;À créer une variable&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-exp&#34; style=&#34;display:none;margin-top:0.8rem;&#34;&gt;&lt;/div&gt;&#xA;  &#xA;  &lt;div class=&#34;qcm-correction&#34; style=&#34;display:none;margin-top:0.5rem;margin-left:2rem;padding:0.8rem 1rem;background:none;border-left:3px solid none;border-radius:0 4px 4px 0;&#34;&gt;&#xA;    &lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Instruction&lt;/th&gt;&#xA;          &lt;th&gt;Rôle&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;print(x)&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;&lt;strong&gt;Affiche&lt;/strong&gt; &lt;code&gt;x&lt;/code&gt; à l&amp;rsquo;écran&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;return x&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;&lt;strong&gt;Renvoie&lt;/strong&gt; &lt;code&gt;x&lt;/code&gt; à celui qui appelle la fonction&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;p&gt;Sans &lt;code&gt;return&lt;/code&gt;, une fonction renvoie automatiquement &lt;code&gt;None&lt;/code&gt;. &lt;code&gt;print&lt;/code&gt; à l&amp;rsquo;intérieur d&amp;rsquo;une fonction affiche mais ne transmet rien.&lt;/p&gt;</description>
    </item>
    <item>
      <title>QCM - Boucles bornées</title>
      <link>http://localhost:1313/mabemat/snt/seance-04-boucles-bornees-qcm/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/mabemat/snt/seance-04-boucles-bornees-qcm/</guid>
      <description>&lt;div class=&#34;qcm-q&#34; data-correct=&#34;1&#34;&gt;&#xA;  &lt;div class=&#34;qcm-question&#34;&gt;&#xA;    Quel mot-clé permet de &lt;strong&gt;répéter&lt;/strong&gt; un nombre fixé de fois un bloc d&amp;rsquo;instructions ?&#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-opts&#34;&gt;&#xA;    &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;0&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;repeat&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;1&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;for&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;2&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;loop&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;      &#xA;      &lt;div class=&#34;qcm-o&#34; data-index=&#34;3&#34; onclick=&#34;qcmCheck(this)&#34;&gt;&#xA;        &lt;div class=&#34;rd&#34;&gt;&lt;/div&gt;&#xA;        &lt;span&gt;&lt;code&gt;while&lt;/code&gt;&lt;/span&gt;&#xA;      &lt;/div&gt;&#xA;      &#xA;      &#xA;    &#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;qcm-exp&#34; style=&#34;display:none;margin-top:0.8rem;&#34;&gt;&lt;/div&gt;&#xA;  &#xA;  &lt;div class=&#34;qcm-correction&#34; style=&#34;display:none;margin-top:0.5rem;margin-left:2rem;padding:0.8rem 1rem;background:none;border-left:3px solid none;border-radius:0 4px 4px 0;&#34;&gt;&#xA;    &lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Mot-clé&lt;/th&gt;&#xA;          &lt;th&gt;Rôle en Python&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;for&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Répète un bloc un &lt;strong&gt;nombre donné&lt;/strong&gt; de fois (boucle bornée)&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;while&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Répète tant qu&amp;rsquo;une condition est vraie (boucle non bornée)&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;repeat&lt;/code&gt;, &lt;code&gt;loop&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;N&amp;rsquo;existent pas en Python&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;p&gt;&lt;strong&gt;Réponse : &lt;code&gt;for&lt;/code&gt;&lt;/strong&gt;&lt;/p&gt;&#xA;  &lt;/div&gt;&#xA;  &#xA;&lt;/div&gt;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;  &#xA;  &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;    &#xA;  &#xA;&#xA;  &#xA;  &#xA;  &#xA;&#xA;&#xA;&lt;div class=&#34;qcm-q&#34; data-correct=&#34;2&#34;&gt;&#xA;  &lt;div class=&#34;qcm-question&#34;&gt;&#xA;    &lt;p&gt;Par quel caractère doit se terminer la &lt;strong&gt;première ligne&lt;/strong&gt; d&amp;rsquo;une boucle &lt;code&gt;for&lt;/code&gt; ?&lt;/p&gt;</description>
    </item>
