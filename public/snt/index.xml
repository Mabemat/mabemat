 &lt;table>
 &lt;thead>
 &lt;tr>
 &lt;th>Mot-clé&lt;/th>
 &lt;th>Rôle en Python&lt;/th>
 &lt;/tr>
 &lt;/thead>
 &lt;tbody>
 &lt;tr>
 &lt;td>&lt;code>for&lt;/code>&lt;/td>
 &lt;td>Répète un nombre &lt;strong>connu&lt;/strong> de fois (boucle bornée)&lt;/td>
 &lt;/tr>
 &lt;tr>
