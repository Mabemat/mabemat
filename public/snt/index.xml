 &lt;/tr>
 &lt;tr>
 &lt;td>&lt;code>while&lt;/code>&lt;/td>
 &lt;td>Répète tant qu&amp;rsquo;une condition est vraie (boucle non bornée)&lt;/td>
 &lt;/tr>
 &lt;tr>
 &lt;td>&lt;code>repeat&lt;/code>, &lt;code>loop&lt;/code>&lt;/td>
 &lt;td>N&amp;rsquo;existent pas en Python&lt;/td>
 &lt;/tr>
 &lt;/tbody>
&lt;/table>
&lt;p>&lt;strong>Réponse : &lt;code>for&lt;/code>&lt;/strong>&lt;/p>
 &lt;/div>
 
&lt;/div>






















 
 
 

 
 
 
 
 

 
 
 
 
 
 

 
 
 
 
 
 

 
 
 
 
 
 

 
 
 
 
 
 

 
 
 
 
 

 
 
 
 
 

 
 
 
 
 

 
 
 
 
 

 
 
 


&lt;div class="qcm-q" data-correct="2">
