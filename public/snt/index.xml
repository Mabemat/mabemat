 &lt;/div>
 
 
 
 
 &lt;div class="qcm-o" data-index="1" onclick="qcmCheck(this)">
 &lt;div class="rd">&lt;/div>
 &lt;span>&lt;code>for&lt;/code>&lt;/span>
 &lt;/div>
 
 
 
 
 &lt;div class="qcm-o" data-index="2" onclick="qcmCheck(this)">
 &lt;div class="rd">&lt;/div>
 &lt;span>&lt;code>loop&lt;/code>&lt;/span>
 &lt;/div>
 
 
 
 
 &lt;div class="qcm-o" data-index="3" onclick="qcmCheck(this)">
 &lt;div class="rd">&lt;/div>
 &lt;span>&lt;code>while&lt;/code>&lt;/span>
 &lt;/div>
 
 
 
 &lt;/div>

 &lt;div class="qcm-exp" style="display:none;margin-top:0.8rem;">&lt;/div>
 
 &lt;div class="qcm-correction" style="display:none;margin-top:0.5rem;margin-left:2rem;padding:0.8rem 1rem;background:none;border-left:3px solid none;border-radius:0 4px 4px 0;">
 &lt;table>
 &lt;thead>
 &lt;tr>
 &lt;th>Mot-clé&lt;/th>
 &lt;th>Rôle en Python&lt;/th>
 &lt;/tr>
 &lt;/thead>
 &lt;tbody>
 &lt;tr>
 &lt;td>&lt;code>for&lt;/code>&lt;/td>
